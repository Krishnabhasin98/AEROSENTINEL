# AeroSentinel Environment Configuration

# TinyFish.ai API Key
# Sign up at https://tinyfish.ai to get your key, then paste it below:
TINYFISH_API_KEY=

# TinyFish API Base URL (Default: https://api.tinyfish.ai/v1)
TINYFISH_API_BASE=https://api.tinyfish.ai/v1

# Simulation & Server Defaults
SIMULATION_TICK_SECONDS=2.0
MIN_BATTERY_RESERVE_PCT=20.0
DEFAULT_CRUISE_SPEED_KMH=60.0
DEFAULT_CRUISE_ALTITUDE_M=120.0
